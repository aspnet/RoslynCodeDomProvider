<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildThisFileDirectory),RoslynCodeProvider.sln))\tools\RoslynCodeProvider.settings.targets" />
  <PropertyGroup>
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>
    <NuGetPackageId>$(MSBuildProjectName)</NuGetPackageId>
    <NuSpecFile>$(MSBuildProjectName).nuspec</NuSpecFile>
  </PropertyGroup>

  <!-- Get the Roslyn toolset -->
  <Target Name="DownloadRoslynBinariesToToolsFolder" BeforeTargets="GetNugetContentFromProject">
    <PropertyGroup>
      <RoslynPackageInstallPath>$(IntermediateOutputPath)RoslynPackage</RoslynPackageInstallPath>
      <RoslynPackageExtractPath>$(RoslynPackageInstallPath)\Microsoft.Net.Compilers.Toolset</RoslynPackageExtractPath>
      <RoslynPackageToolsPath>$(NupkgToolPath)$(LocalRoslynFolderName)</RoslynPackageToolsPath>
    </PropertyGroup>

    <RemoveDir Directories="$(RoslynPackageInstallPath);$(RoslynPackageToolsPath)" />
    <MakeDir Directories="$(RoslynPackageInstallPath)" />
    <Exec Command="&quot;$(NuGetExePath)&quot; install Microsoft.Net.Compilers.Toolset -Version &quot;$(MSNetCompilersNuGetPackageVersion)&quot; -ConfigFile &quot;$(RepositoryRoot).nuget\NuGet.Config&quot; -OutputDirectory &quot;$(RoslynPackageInstallPath)&quot; -ExcludeVersion -DirectDownload -NoCache -NonInteractive"
          LogStandardErrorAsError="true" />

    <ItemGroup>
      <RoslynCompilerFile Include="$(RoslynPackageExtractPath)\tasks\net472\*" />
    </ItemGroup>
    <Error Condition="'@(RoslynCompilerFile)' == ''"
           Text="Microsoft.Net.Compilers.Toolset $(MSNetCompilersNuGetPackageVersion) did not contain any files under tasks\net472." />
    <MakeDir Directories="$(RoslynPackageToolsPath)" />
    <Copy SourceFiles="@(RoslynCompilerFile)" DestinationFolder="$(RoslynPackageToolsPath)" />
  </Target>

  <!-- Content to pack -->
  <ItemGroup>
    <NuGetContent Include="$(AssemblyName).dll">
      <Source>$(AssemblyPath)</Source>
      <Destination>lib\net472</Destination>
    </NuGetContent>
    <NuGetContent Include="$(AssemblyName).xml">
      <Source>$(OutputPath)</Source>
      <Destination>lib\net472</Destination>
    </NuGetContent>
    <NuGetContent Include="$(AssemblyName).pdb" Condition="'$(NuGetPackSymbols)' == 'true'">
      <Source>$(OutputPath)</Source>
      <Destination>lib\net472</Destination>
    </NuGetContent>
    <NuGetContentProject Include="$(RepositoryRoot)\src\DotNetCompilerPlatform\DotNetCompilerPlatform.csproj" Condition="'$(NuGetPackSymbols)' == 'true'" />
    <NuGetContent Include="DotNetCompilerPlatformTasks.dll">
      <Source>$(OutputPath)</Source>
      <Destination>tasks</Destination>
    </NuGetContent>
    <NuGetContent Include="System.Management.dll">
      <Source>$(OutputPath)</Source>
      <Destination>tasks</Destination>
    </NuGetContent>
    <NuGetContent Include="build\pp\*">
      <Destination>build\net472</Destination>
    </NuGetContent>
    <NuGetContent Include="tools\$(LocalRoslynFolderName)\*">
      <Destination>tools\$(LocalRoslynFolderName)</Destination>
    </NuGetContent>
    <NuGetContent Include="Readme.md">
      <Destination>docs\Readme.md</Destination>
    </NuGetContent>
    <NuGetContent Include="..\icons\*">
      <Destination>icons</Destination>
    </NuGetContent>
  </ItemGroup>
  <Import Project="$(RepositoryRoot)Tools\NuGetProj.targets"/>
</Project>